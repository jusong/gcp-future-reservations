# GCP Future Reservations config
#
# Values under zones are incremental demand (To Add).
# At runtime the script counts running VMs as inventory;
# future reservation --total-count = demand + inventory.
#
# Machine type: pick one of
#   1) machine_type: a predefined or fully formed custom string
#      - n2-standard-8 / n2-highmem-8 / n2-standard-64 ...
#      - n2-custom-64-131072 / custom-32-29440 ...
#   2) series + cpu + memory: normalized per GCP custom-machine rules
#      - memory accepts 128G / 32GB / 131072 / 131072MB / 0.5G, converted to MB
#      - over the series standard ratio appends -ext (N1=6.5 GB/vCPU, N2/N2D/N4*=8 GB/vCPU)
#      - E2 does not support -ext; over the cap raises an error
#      - optional extended: true|false to override

defaults:
  project: your-gcp-project-id
  region: asia-northeast1
  name_prefix: example-fr
  start_time: "2026-05-27T00:00:00Z"
  end_time: "2026-06-16T15:00:00Z"
  planning_status: DRAFT          # DRAFT | SUBMITTED
  share_setting: local            # local | specific_projects
  # When share_setting=specific_projects, shared_projects is required:
  # shared_projects:
  #   - proj-a
  #   - proj-b
  auto_delete_auto_created_reservations: true
  # auto_created_reservations_delete_time: "2026-06-01T00:00:00Z"
  # vm_family: GENERAL_PURPOSE_N2
  # instance_label_filter: "app=myapp"   # optional: only count RUNNING VMs with this label

reservations:
  # ---- App A (compute) ----
  - name: app-a-64v128g
    series: n2
    cpu: 64
    memory: 128G
    zones:
      asia-northeast1-a: 5
      asia-northeast1-b: 5
      asia-northeast1-c: 4

  - name: app-a-16v32g
    series: n2
    cpu: 16
    memory: 32G
    zones:
      asia-northeast1-a: 2
      asia-northeast1-b: 2
      asia-northeast1-c: 2

  - name: app-a-8v16g
    series: n2
    cpu: 8
    memory: 16G
    zones:
      asia-northeast1-a: 1
      asia-northeast1-b: 1

  - name: app-a-8v32g
    machine_type: n2-standard-8
    zones:
      asia-northeast1-a: 1

  # ---- App B (storage) ----
  - name: app-b-64c256g
    machine_type: n2-standard-64
    zones:
      asia-northeast1-a: 5
      asia-northeast1-b: 5
      asia-northeast1-c: 5

  - name: app-b-16c64g
    machine_type: n2-standard-16
    zones:
      asia-northeast1-a: 2
      asia-northeast1-b: 2
      asia-northeast1-c: 2

  - name: app-b-8c64g
    machine_type: n2-highmem-8
    zones:
      asia-northeast1-a: 1
      asia-northeast1-b: 1
      asia-northeast1-c: 1

  - name: app-b-32c128g
    machine_type: n2-standard-32
    zones:
      asia-northeast1-a: 1
      asia-northeast1-b: 1
      asia-northeast1-c: 1

  # --- per-item override example ---
  # - name: app-a-special
  #   machine_type: n2-standard-16
  #   zones:
  #     asia-northeast1-a: 3
  #   overrides:
  #     start_time: "2026-06-01T00:00:00Z"
  #     end_time:   "2026-07-01T00:00:00Z"
  #     share_setting: specific_projects
  #     shared_projects:
  #       - proj-a
  #       - proj-b
